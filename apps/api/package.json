{
  "name": "@mcg/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@mcg/core": "0.1.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.5.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "permissionless": "0.5.0",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
