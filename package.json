{
  "name": "multichain-claim-gate",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build -w @mcg/core && npm run build -w @mcg/api && npm run build -w @mcg/web",
    "dev:api": "npm run dev -w @mcg/api",
    "dev:web": "npm run dev -w @mcg/web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build -w @mcg/core && npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @mcg/core && npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
