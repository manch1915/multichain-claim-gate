# Copy to .env. Used by apps/api in development and by docker compose.

# --- API -------------------------------------------------------------------
DATABASE_URL=postgres://meridian:meridian@localhost:5463/meridian
# Origin of the web app. Goes into SIWE/SIWS messages and decides cookie flags.
PUBLIC_ORIGIN=http://localhost:3000
# At least 32 random characters, e.g. `openssl rand -hex 32`
APP_SECRET=
# Comma-separated wallet addresses that can import whitelists and edit rules
ADMIN_ADDRESSES=

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SOLANA_RPC_URL=https://api.devnet.solana.com
# Set to a local node (anvil) to allow chain 31337 in development
ANVIL_RPC_URL=

# Owner of the distributor and pass contracts. Testnet key only.
SPONSOR_PRIVATE_KEY=
# With a Pimlico key the sponsor sends EIP-7702 user operations and the paymaster pays gas.
# Without it the sponsor key pays gas itself.
PIMLICO_API_KEY=
PIMLICO_SPONSORSHIP_POLICY_ID=
# Fee payer and distributor authority on devnet: base58 secret or solana-keygen JSON array
SOLANA_FEE_PAYER_SECRET=

# Contract addresses written by the deploy scripts
DEPLOYMENTS_FILE=./deployments/testnet.json

# Optional: one-time invites into a private group for wallets that pass the lounge rule
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web (build time) ------------------------------------------------------
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contract deployment (scripts only, never read by the app) --------------
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
